# Copie para .env.production e aponte o DNS deste host para a VPS.
NYTHARA_DOMAIN=jogo.exemplo.com

# Use um identificador imutável em releases (por exemplo, o SHA do commit).
NYTHARA_IMAGE_TAG=local

# E-mail transacional e recuperação de senha. Verifique seu domínio no Resend.
# O arquivo .env.production real é ignorado pelo Git e deve usar modo 0600.
PUBLIC_APP_URL=https://jogo.exemplo.com

# Login social. Cadastre PUBLIC_APP_URL/v1/auth/google/callback como redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
RESEND_FROM_EMAIL="Nythara <no-reply@jogo.exemplo.com>"
RESEND_API_KEY=re_substitua_pela_chave_real
# Segredo whsec_ retornado ao cadastrar PUBLIC_APP_URL/v1/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_substitua_pelo_segredo_real

# Opcional: diretório absoluto fora do checkout.
# NYTHARA_SECRETS_DIR=/etc/nythara/secrets
